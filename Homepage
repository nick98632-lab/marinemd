<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content="MarineMD - Bridging innovation and inclusion for a better tomorrow. Veteran-owned think tank. Beta apps: Convict Conditioning and Red Zone." />
  <title>MarineMD</title>
  <style>
    :root{
      --bg:#070a0f;
      --panel:#0e1420;
      --card:#101a2a;
      --muted:#9aa4b2;
      --text:#e6edf3;
      --line:rgba(255,255,255,.10);
      --line2:rgba(255,255,255,.14);
      --blue:#1f6feb;
      --green:#2ea043;
      --amber:#f2c744;
      --shadow:0 18px 60px rgba(0,0,0,.55);
      --radius:18px;
      --radius2:14px;
    }
    *{box-sizing:border-box}
    html,body{height:100%}
    body{
      margin:0;
      font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
      background:
        radial-gradient(900px 600px at 14% 12%, rgba(31,111,235,.28), transparent 60%),
        radial-gradient(880px 640px at 84% 18%, rgba(46,160,67,.18), transparent 62%),
        radial-gradient(650px 520px at 58% 82%, rgba(242,199,68,.10), transparent 60%),
        linear-gradient(180deg, #05070b 0%, #070a0f 60%, #060910 100%);
      color:var(--text);
      line-height:1.45;
    }
    a{color:inherit;text-decoration:none}
    .wrap{max-width:1080px;margin:0 auto;padding:22px}
    .topbar{
      display:flex;align-items:center;justify-content:space-between;gap:16px;
      padding:10px 0 18px 0;
    }
    .brand{display:flex;align-items:center;gap:14px}
    .logo{
      width:62px;height:62px;border-radius:16px;
      border:1px solid var(--line);
      background:rgba(255,255,255,.03);
      overflow:hidden;box-shadow:var(--shadow);
      display:grid;place-items:center;
    }
    .logo img{width:100%;height:100%;object-fit:cover;display:block}
    .brandTitle{font-weight:900;letter-spacing:.4px;font-size:15px;margin:0}
    .brandSub{color:var(--muted);font-size:12px;margin:2px 0 0 0}
    .nav{display:flex;gap:10px;flex-wrap:wrap}
    .pill{
      padding:9px 12px;border:1px solid var(--line);border-radius:999px;
      color:var(--muted);background:rgba(255,255,255,.03);
      font-weight:700;font-size:12px;
    }
    .pill:hover{border-color:var(--line2);color:var(--text)}
    .hero{
      border:1px solid var(--line);
      background:linear-gradient(180deg, rgba(255,255,255,.035), rgba(255,255,255,.02));
      border-radius:var(--radius);
      box-shadow:var(--shadow);
      overflow:hidden;
      position:relative;
    }
    .heroInner{padding:22px}
    .heroGrid{
      display:grid;grid-template-columns:1.2fr .8fr;gap:18px;
      align-items:stretch;
    }
    @media (max-width:900px){
      .heroGrid{grid-template-columns:1fr}
    }
    .title{
      margin:0 0 8px 0;
      font-size:34px;
      letter-spacing:.2px;
      line-height:1.15;
    }
    .tagline{
      margin:0;
      color:rgba(230,237,243,.92);
      font-size:14px;
      max-width:85ch;
    }
    .motto{
      margin-top:10px;
      padding:12px 14px;
      border:1px solid var(--line);
      background:rgba(255,255,255,.03);
      border-radius:var(--radius2);
    }
    .motto strong{display:block;margin-bottom:4px;font-size:12px;letter-spacing:.3px;color:var(--muted);text-transform:uppercase}
    .motto div{font-weight:900;font-size:15px}
    .heroRight{
      border:1px solid var(--line);
      background:rgba(16,26,42,.65);
      border-radius:var(--radius2);
      padding:14px;
      display:flex;flex-direction:column;gap:12px;
    }
    .statRow{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}
    .statLabel{color:var(--muted);font-size:12px;font-weight:800;letter-spacing:.2px}
    .statValue{font-size:12px;font-weight:900}
    .divider{height:1px;background:var(--line);width:100%}
    .ctaRow{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px}
    .btn{
      display:inline-flex;align-items:center;justify-content:center;
      padding:11px 14px;border-radius:14px;border:1px solid transparent;
      font-weight:900;font-size:13px;cursor:pointer;
    }
    .btn.primary{background:linear-gradient(135deg, rgba(31,111,235,.95), rgba(31,111,235,.65));border-color:rgba(31,111,235,.35)}
    .btn.green{background:linear-gradient(135deg, rgba(46,160,67,.95), rgba(46,160,67,.62));border-color:rgba(46,160,67,.35)}
    .btn.ghost{background:transparent;border-color:var(--line);color:var(--muted)}
    .btn:hover{filter:brightness(1.05)}
    .note{
      margin-top:10px;
      color:var(--muted);
      font-size:12px;
    }

    .sectionTitle{
      margin:18px 0 10px 0;
      font-size:13px;
      letter-spacing:.25px;
      color:rgba(230,237,243,.90);
      text-transform:uppercase;
      font-weight:900;
    }

    .apps{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
      gap:14px;
    }
    .card{
      border:1px solid var(--line);
      background:linear-gradient(180deg, rgba(16,26,42,.92), rgba(14,20,32,.92));
      border-radius:var(--radius);
      padding:16px;
      box-shadow:var(--shadow);
      display:flex;flex-direction:column;gap:10px;
      min-height:210px;
      position:relative;
      overflow:hidden;
    }
    .card::before{
      content:"";
      position:absolute;inset:-40px -60px auto auto;
      width:220px;height:220px;
      background:radial-gradient(circle at 30% 30%, rgba(31,111,235,.28), transparent 60%);
      transform:rotate(20deg);
      pointer-events:none;
    }
    .card.red::before{
      background:radial-gradient(circle at 30% 30%, rgba(242,199,68,.16), transparent 60%);
    }
    .card h2{margin:0;font-size:16px;font-weight:900}
    .beta{
      display:inline-flex;align-items:center;gap:8px;
      font-size:12px;font-weight:900;letter-spacing:.2px;
      color:rgba(230,237,243,.92);
    }
    .dot{
      width:10px;height:10px;border-radius:999px;
      background:var(--green);
      box-shadow:0 0 18px rgba(46,160,67,.55);
    }
    .dot.amber{background:var(--amber);box-shadow:0 0 18px rgba(242,199,68,.40)}
    .desc{margin:0;color:var(--muted);font-size:13px}
    .meta{display:flex;gap:8px;flex-wrap:wrap;margin-top:2px}
    .tag{
      font-size:12px;color:var(--muted);
      border:1px solid var(--line);
      background:rgba(255,255,255,.03);
      padding:4px 8px;border-radius:999px;
      font-weight:700;
    }
    .actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:auto}
    .smalllink{color:var(--muted);text-decoration:underline;text-underline-offset:3px}
    footer{
      margin-top:18px;
      color:var(--muted);
      font-size:12px;
      display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;
      padding:12px 2px 6px 2px;
      border-top:1px solid var(--line);
    }
    .mini{
      color:var(--muted);
      font-size:12px;
      border:1px solid var(--line);
      background:rgba(255,255,255,.02);
      border-radius:12px;
      padding:10px 12px;
      margin-top:12px;
    }
    code{color:#c9d1d9}
  </style>
</head>
<body>
  <div class="wrap">
    <div class="topbar">
      <div class="brand">
        <div class="logo" aria-label="MarineMD image">
          <!-- Put your MarineMD image here: /assets/marinemd.png (or change path). -->
          <img src="/assets/marinemd.png" alt="MarineMD" onerror="this.remove(); this.parentElement.textContent='M';" />
        </div>
        <div>
          <p class="brandTitle">MarineMD</p>
          <p class="brandSub">Bridging innovation and inclusion for a better tomorrow.</p>
        </div>
      </div>

      <div class="nav">
        <a class="pill" href="#apps">Apps</a>
        <a class="pill" href="#about">About</a>
        <a class="pill" href="https://diimed.com" target="_blank" rel="noopener noreferrer">DIIMED.com</a>
      </div>
    </div>

    <section class="hero" id="about">
      <div class="heroInner">
        <div class="heroGrid">
          <div>
            <h1 class="title">Veteran-owned innovation that actually ships.</h1>
            <p class="tagline">
              MarineMD is an exclusive, innovative think tank with a diverse range of capabilities, dedicated to solving important issues
              and improving lives through strategic research and practical solutions. Proudly affiliated with the Dyslexia Initiative in Medicine (DIIMED).
            </p>

            <div class="motto" aria-label="MarineMD motto">
              <strong>Motto</strong>
              <div>Bridging innovation and inclusion for a better tomorrow.</div>
            </div>

            <div class="ctaRow">
              <a class="btn primary" href="#apps">Open beta apps</a>
              <a class="btn ghost" href="https://diimed.com" target="_blank" rel="noopener noreferrer">Read: What is MarineMD (DIIMED)</a>
            </div>

            <div class="note">
              Tip: Your apps live at simple URLs like <code>/cc/</code> and <code>/redzone/</code>.
            </div>
          </div>

          <div class="heroRight" aria-label="Quick facts">
            <div class="statRow">
              <div class="statLabel">Status</div>
              <div class="statValue">Public beta</div>
            </div>
            <div class="divider"></div>
            <div class="statRow">
              <div class="statLabel">Model</div>
              <div class="statValue">Practical tools + research</div>
            </div>
            <div class="divider"></div>
            <div class="statRow">
              <div class="statLabel">Ownership</div>
              <div class="statValue">Veteran-owned & operated</div>
            </div>
            <div class="divider"></div>
            <div class="statRow">
              <div class="statLabel">Affiliation</div>
              <div class="statValue">DIIMED</div>
            </div>
            <div class="divider"></div>
            <div class="statRow">
              <div class="statLabel">Focus</div>
              <div class="statValue">Inclusion + innovation</div>
            </div>

            <div class="mini">
              If you want the full mission write-up, DIIMED.com is the primary explainer page for MarineMD.
            </div>

            <div class="ctaRow">
              <a class="btn green" href="https://diimed.com" target="_blank" rel="noopener noreferrer">Go to DIIMED.com</a>
              <a class="btn ghost" href="#apps">Apps</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="sectionTitle" id="apps">Apps (Beta)</div>

    <section class="apps" aria-label="MarineMD beta apps">
      <div class="card">
        <div class="beta"><span class="dot"></span> Convict Conditioning (Beta)</div>
        <h2>Convict Conditioning App</h2>
        <p class="desc">Progressions, sessions, logging. Built to turn discipline into data.</p>
        <div class="meta">
          <span class="tag">Fitness</span>
          <span class="tag">Mobile-first</span>
          <span class="tag">Local save</span>
        </div>
        <div class="actions">
          <a class="btn primary" href="/cc/">Open</a>
          <a class="btn ghost" href="/cc/" onclick="window.open('/cc/','_blank'); return false;">New tab</a>
        </div>
      </div>

      <div class="card red">
        <div class="beta"><span class="dot amber"></span> Red Zone (Beta)</div>
        <h2>Red Zone</h2>
        <p class="desc">Rapid checklists and decision support workflows for high-stakes moments.</p>
        <div class="meta">
          <span class="tag">Clinical</span>
          <span class="tag">Systems</span>
          <span class="tag">Fast execution</span>
        </div>
        <div class="actions">
          <a class="btn green" href="/redzone/">Open</a>
          <a class="btn ghost" href="#" onclick="alert('If this page is empty, publish it by adding /redzone/index.html in your repo.'); return false;">Publish help</a>
        </div>
      </div>

      <div class="card">
        <div class="beta"><span class="dot"></span> Add another tool</div>
        <h2>Drop-in apps</h2>
        <p class="desc">Create a folder and add an <code>index.html</code> inside it. Link it from here. That’s it.</p>
        <div class="meta">
          <span class="tag">GitHub + Netlify</span>
          <span class="tag">No build step</span>
          <span class="tag">Simple deploy</span>
        </div>
        <div class="actions">
          <a class="btn ghost" href="https://diimed.com" target="_blank" rel="noopener noreferrer">Mission</a>
          <a class="btn ghost" href="#about">Top</a>
        </div>
      </div>
    </section>

    <footer>
      <div>© <span id="y"></span> MarineMD</div>
      <div>
        <a class="smalllink" href="https://diimed.com" target="_blank" rel="noopener noreferrer">DIIMED.com</a>
        <span style="margin:0 8px">·</span>
        <a class="smalllink" href="https://marinemd.org">marinemd.org</a>
      </div>
    </footer>
  </div>

  <script>
    document.getElementById('y').textContent = new Date().getFullYear();
  </script>
</body>
</html>
